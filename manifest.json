{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "1.0",
  "description": "Capture full AI chat conversations and export them instantly to any other AI model.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
